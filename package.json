{
  "name": "r2browser",
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "init": "bash scripts/init.sh || powershell -ExecutionPolicy Bypass -File scripts/init.ps1",
    "dev": "tauri dev",
    "build": "tsc --noEmit && vite build",
    "build-tauri": "tauri build",
    "build:release": "pnpm run build && pnpm tauri build",
    "build:debug": "pnpm run build && pnpm tauri build --debug",
    "build:clean": "pnpm run clean && pnpm run build:release",
    "preview": "vite preview",
    "dev-web": "vite",
    "tauri": "tauri",
    "check": "tsc --noEmit",
    "lint": "eslint .",
    "clean": "rimraf dist src-tauri/target",
    "setup-signing": "node scripts/setup-signing.mjs",
    "release": "node scripts/release.mjs",
    "release:patch": "node scripts/release.mjs --channel stable --bump patch",
    "release:minor": "node scripts/release.mjs --channel stable --bump minor",
    "release:major": "node scripts/release.mjs --channel stable --bump major",
    "release:promote": "node scripts/release.mjs --channel stable --bump release",
    "release:beta:patch": "node scripts/release.mjs --channel beta --bump patch",
    "release:beta:minor": "node scripts/release.mjs --channel beta --bump minor",
    "release:beta:major": "node scripts/release.mjs --channel beta --bump major",
    "release:beta:next": "node scripts/release.mjs --channel beta --bump prerelease"
  },
  "homepage": "https://github.com/backrunner/r2browser",
  "repository": {
    "type": "git",
    "url": "https://github.com/backrunner/r2browser.git"
  },
  "author": "BackRunner",
  "license": "Apache-2.0",
  "keywords": [
    "cloudflare",
    "r2",
    "s3",
    "storage",
    "gui",
    "tauri",
    "desktop"
  ],
  "dependencies": {
    "@iconify/react": "^6.0.2",
    "@radix-ui/react-checkbox": "^1.3.6",
    "@radix-ui/react-context-menu": "^2.3.2",
    "@radix-ui/react-dialog": "^1.1.18",
    "@radix-ui/react-dropdown-menu": "^2.1.19",
    "@radix-ui/react-label": "^2.1.11",
    "@radix-ui/react-progress": "^1.1.11",
    "@radix-ui/react-select": "^2.3.2",
    "@radix-ui/react-separator": "^1.1.11",
    "@radix-ui/react-slot": "^1.3.0",
    "@radix-ui/react-switch": "^1.3.2",
    "@radix-ui/react-tabs": "^1.1.16",
    "@radix-ui/react-toast": "^1.2.18",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "file-saver": "^2.0.5",
    "i18next": "^26.3.4",
    "i18next-browser-languagedetector": "^8.2.1",
    "lucide-react": "^1.23.0",
    "pdfjs-dist": "^6.1.200",
    "prismjs": "^1.30.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-dropzone": "^15.0.0",
    "react-i18next": "^17.0.8",
    "react-pdf": "^10.4.1",
    "react-router-dom": "^7.18.1",
    "react-virtualized-auto-sizer": "^2.0.3",
    "react-window": "^2.2.7",
    "react-window-infinite-loader": "^2.0.1",
    "react-zoom-pan-pinch": "^4.0.3",
    "tailwind-merge": "^3.6.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@iconify-json/heroicons": "^1.2.3",
    "@iconify-json/lucide": "^1.2.116",
    "@iconify-json/tabler": "^1.2.35",
    "@tauri-apps/cli": "^2.11.4",
    "@types/file-saver": "^2.0.7",
    "@types/node": "^26.1.0",
    "@types/prismjs": "^1.26.6",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.62.1",
    "@typescript-eslint/parser": "^8.62.1",
    "@unocss/reset": "^66.7.4",
    "@vitejs/plugin-react": "^6.0.3",
    "autoprefixer": "^10.5.2",
    "eslint": "^10.6.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3",
    "unocss": "^66.7.4",
    "vite": "^8.1.3"
  }
}
