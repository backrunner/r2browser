{
  "name": "r2browser",
  "version": "0.1.1-beta.4",
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "scripts": {
    "init": "bash scripts/init.sh || powershell -ExecutionPolicy Bypass -File scripts/init.ps1",
    "dev": "tauri dev",
    "build": "tsc --noEmit && vite build",
    "build-tauri": "tauri build",
    "build:release": "pnpm run build && pnpm tauri build",
    "build:debug": "pnpm run build && pnpm tauri build --debug",
    "build:clean": "pnpm run clean && pnpm run build:release",
    "preview": "vite preview",
    "dev-web": "vite",
    "tauri": "tauri",
    "check": "tsc --noEmit",
    "lint": "eslint .",
    "clean": "rimraf dist src-tauri/target",
    "setup-signing": "node scripts/setup-signing.mjs",
    "release": "node scripts/release.mjs",
    "release:patch": "node scripts/release.mjs --channel stable --bump patch",
    "release:minor": "node scripts/release.mjs --channel stable --bump minor",
    "release:major": "node scripts/release.mjs --channel stable --bump major",
    "release:promote": "node scripts/release.mjs --channel stable --bump release",
    "release:beta:patch": "node scripts/release.mjs --channel beta --bump patch",
    "release:beta:minor": "node scripts/release.mjs --channel beta --bump minor",
    "release:beta:major": "node scripts/release.mjs --channel beta --bump major",
    "release:beta:next": "node scripts/release.mjs --channel beta --bump prerelease",
    "test": "node --test tests/*.test.mjs"
  },
  "homepage": "https://github.com/backrunner/r2browser",
  "repository": {
    "type": "git",
    "url": "https://github.com/backrunner/r2browser.git"
  },
  "author": "BackRunner",
  "license": "Apache-2.0",
  "keywords": [
    "cloudflare",
    "r2",
    "s3",
    "storage",
    "gui",
    "tauri",
    "desktop"
  ],
  "dependencies": {
    "@iconify/react": "^6.0.2",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-context-menu": "^2.3.7",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-progress": "^1.1.16",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-toast": "^1.2.23",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "@tauri-apps/plugin-fs": "^2.5.2",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.11.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "file-saver": "^2.0.5",
    "i18next": "^26.4.2",
    "i18next-browser-languagedetector": "^8.2.1",
    "lucide-react": "^1.41.0",
    "pdfjs-dist": "^6.3.289",
    "prismjs": "^1.30.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-dropzone": "^20.1.1",
    "react-i18next": "^17.0.13",
    "react-pdf": "^10.5.0",
    "react-router-dom": "^7.18.3",
    "react-virtualized-auto-sizer": "^2.0.3",
    "react-window": "^2.3.0",
    "react-window-infinite-loader": "^2.0.1",
    "react-zoom-pan-pinch": "^4.2.0",
    "tailwind-merge": "^3.6.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@iconify-json/heroicons": "^1.2.3",
    "@iconify-json/lucide": "^1.2.129",
    "@iconify-json/tabler": "^1.2.38",
    "@tauri-apps/cli": "^2.11.4",
    "@types/file-saver": "^2.0.7",
    "@types/node": "^26.4.1",
    "@types/prismjs": "^1.26.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@typescript-eslint/eslint-plugin": "^8.69.0",
    "@typescript-eslint/parser": "^8.69.0",
    "@unocss/reset": "^66.10.0",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.5.5",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3",
    "unocss": "^66.10.0",
    "vite": "^8.2.2"
  },
  "engines": {
    "node": ">=24.11.0"
  }
}
