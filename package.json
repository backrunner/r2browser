{
  "name": "r2browser",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "init": "bash scripts/init.sh || powershell -ExecutionPolicy Bypass -File scripts/init.ps1",
    "dev": "tauri dev",
    "build": "tsc --noEmit && vite build",
    "build-tauri": "tauri build",
    "build:release": "pnpm run build && pnpm tauri build",
    "build:debug": "pnpm run build && pnpm tauri build --debug",
    "build:clean": "pnpm run clean && pnpm run build:release",
    "preview": "vite preview",
    "dev-web": "vite",
    "tauri": "tauri",
    "check": "tsc --noEmit",
    "lint": "eslint .",
    "clean": "rimraf dist src-tauri/target",
    "setup-signing": "node scripts/setup-signing.js",
    "release:patch": "node scripts/bump-version.js patch",
    "release:minor": "node scripts/bump-version.js minor",
    "release:major": "node scripts/bump-version.js major"
  },
  "homepage": "https://github.com/backrunner/r2browser",
  "repository": {
    "type": "git",
    "url": "https://github.com/backrunner/r2browser.git"
  },
  "author": "BackRunner",
  "license": "Apache-2.0",
  "keywords": [
    "cloudflare",
    "r2",
    "s3",
    "storage",
    "gui",
    "tauri",
    "desktop"
  ],
  "dependencies": {
    "@iconify/react": "^6.0.2",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-context-menu": "^2.2.16",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toast": "^1.2.15",
    "@tauri-apps/api": "^2.10.1",
    "@tauri-apps/plugin-dialog": "^2.6.0",
    "@tauri-apps/plugin-fs": "^2.4.5",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "file-saver": "^2.0.5",
    "i18next": "^25.8.18",
    "i18next-browser-languagedetector": "^8.2.1",
    "lucide-react": "^0.577.0",
    "pdfjs-dist": "^5.5.207",
    "prismjs": "^1.30.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-dropzone": "^15.0.0",
    "react-i18next": "^16.5.8",
    "react-pdf": "^10.4.1",
    "react-router-dom": "^7.13.1",
    "react-virtualized-auto-sizer": "^2.0.3",
    "react-window": "^2.2.7",
    "react-window-infinite-loader": "^2.0.1",
    "react-zoom-pan-pinch": "^3.7.0",
    "tailwind-merge": "^3.5.0",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@iconify-json/heroicons": "^1.2.3",
    "@iconify-json/lucide": "^1.2.97",
    "@iconify-json/tabler": "^1.2.31",
    "@tauri-apps/cli": "^2.10.1",
    "@types/file-saver": "^2.0.7",
    "@types/node": "^25.4.0",
    "@types/prismjs": "^1.26.6",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.57.0",
    "@typescript-eslint/parser": "^8.57.0",
    "@unocss/reset": "^66.6.6",
    "@vitejs/plugin-react": "^6.0.0",
    "autoprefixer": "^10.4.27",
    "eslint": "^10.0.3",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "rimraf": "^6.1.3",
    "typescript": "^5.9.3",
    "unocss": "^66.6.6",
    "vite": "^8.0.0"
  }
}
